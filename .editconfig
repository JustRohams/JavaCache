root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,scss,json,yml,yaml,html,htm}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{xml,dist,ini}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.{min.js,min.css}]
insert_final_newline = false